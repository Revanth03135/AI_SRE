# Python environments and caches
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets and local environment files
.env
.env.*
*.env
*.env.*
!.env.example

# Large/generated datasets and local data (anchored to the repository root)
/data/
gaia_download/
tmp_gaia_samples/

# Local experiment stores and databases
/mlruns/
/mlflow.db

# Trained model binaries and other artifacts (the folder itself is kept by .gitkeep)
ml/models/*
!ml/models/.gitkeep

# Temporary local outputs
tmp_*.csv
*.err

# Local incident database (created on first API start)
backend/ai_sre/api/*.db
*.db-journal

# Online Boutique is installed from its Helm chart, not vendored here
.official-microservices-demo/

# Terraform: local state, provider cache, logs, and the generated kubeconfig
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.log
infra/terraform/.kube/
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
